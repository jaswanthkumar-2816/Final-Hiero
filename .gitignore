**/node_modules/
node_modules/
.env
*.log
uploads/
data/
temp/
.cache/
.DS_Store
*.pdf
all_templates_test_*/
generated_templates_*/
template_test_output*/
resume_previews/
downloaded-resumes/
hiero-unified-deploy/
test_oauth_init.js
test_*.js

# Local scripts and documentation
*.sh
*.md
*.out
*.png
*.jpeg
*.jpg

# Allow essential branding
!*logohiero*.png
!*logo-hiero*.png
!hiero-logo-icon.png
!Screenshot*.png
!WhatsApp*.jpeg
!favicon*.png
!favicon.ico
!test-photo.png

*.backup
*.backup.*
!README.md
!📌_READ_ME_FIRST.md

# Allow mock interview workspace
!mock_interview/
!mock_interview/**
!UPDATE.md


scratch/

# symlinked out of iCloud — the trailing-slash rule above does not match a symlink
node_modules

# login-tracking backups contain user emails/IPs — never publish
backups/

# App icons and interview panel photos. `*.png` above excluded these, so the
# icon set and the panel portraits were never reaching the repository -- the
# server would 404 on them in production while working fine locally.
!icons/
!icons/*.png
!apple-touch-icon.png
!mock_interview/panel/
!mock_interview/panel/*.png
!mock_interview/panel/*.webp

# Runtime state, not source. transcript-cache.json alone is 71 MB and is
# rewritten constantly; committing each revision is what made .git larger than
# the project. These are all regenerated or live in MongoDB.
data/transcript-cache.json
data/video-modules-cache.json
hiero-backend/python_services/jobs.db
login_tracking.json
