# Server Configuration
PORT=4040
NODE_ENV=development

# Groq API Configuration (REQUIRED)
GROQ_API_KEY=your_groq_api_key_here

# Groq Model Preferences
# Primary: openai/gpt-oss-120b (premier 120B parameter model with exceptional instruction following & JSON extraction)
# Fallbacks: openai/gpt-oss-20b, qwen/qwen3.8-27b
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b

# Max File Upload Size in Megabytes (default: 15MB)
MAX_FILE_SIZE_MB=15
